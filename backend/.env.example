# ========================================
# Base de Datos MySQL
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=narto_db
DB_USER=root
DB_PASSWORD=
# Para MySQL instalado en esta computadora. La conexión remota usa TLS por defecto.
DB_SSL=false

# ========================================
# JWT y Seguridad
# ========================================
JWT_SECRET=tu_clave_jwt_muy_segura_y_larga_aqui_cambiar_en_produccion

# ========================================
# Servidor
# ========================================
NODE_ENV=development
API_PORT=5000
API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
